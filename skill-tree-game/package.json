{
  "name": "skill-tree-game",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:retreat": "vite --mode retreat",
    "build": "vite build",
    "build:retreat": "vite build --mode retreat",
    "preview": "vite preview",
    "deploy": "npm run build && firebase deploy --only hosting:futurecoding",
    "deploy:retreat": "npm run build:retreat && firebase deploy --only hosting:futurecoding-retreat",
    "deploy:all": "npm run build && npm run build:retreat && firebase deploy --only hosting",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "init-db": "node scripts/initFirestore.js",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.1",
    "firebase": "^10.7.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.1",
    "lucide-react": "^0.535.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.0",
    "recharts": "^3.1.2",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/postcss": "^4.1.11",
    "@tailwindcss/typography": "^0.5.16",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.11",
    "vite": "^5.0.0"
  }
}
